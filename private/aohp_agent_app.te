# AOHP AgentDriver: debug / adb install builds run as untrusted_app. They still need to
# resolve AOHP binder services via ServiceManager; each Binder call is permission-gated in
# system_server (MANAGE_AOHP_VIRTUAL_DISPLAY).
allow untrusted_app_all aohp_virtual_display_service:service_manager find;
allow untrusted_app_all aohp_container_service:service_manager find;
allow untrusted_app_all aohp_agent_view_service:service_manager find;
