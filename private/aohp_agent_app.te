# AOHP AgentDriver: debug / adb install builds run as untrusted_app. When shipped as a
# platform-signed priv-app it lands in platform_app (signature wins over privApp in
# seapp_contexts), and a plain priv-app build lands in priv_app. All three need to
# resolve AOHP binder services via ServiceManager; each Binder call is permission-gated
# in system_server (MANAGE_AOHP_VIRTUAL_DISPLAY).
allow untrusted_app_all aohp_virtual_display_service:service_manager find;
allow untrusted_app_all aohp_container_service:service_manager find;
allow untrusted_app_all aohp_agent_view_service:service_manager find;
allow untrusted_app_all aohp_vault_service:service_manager find;
allow untrusted_app_all aohp_taint_tracker_service:service_manager find;
allow untrusted_app_all aohp_sensitivity_registry_service:service_manager find;
allow untrusted_app_all aohp_security_bridge_service:service_manager find;
allow untrusted_app_all aohp_security_cmd_service:service_manager find;
allow untrusted_app_all aohp_file_bridge_service:service_manager find;
allow untrusted_app_all aohp_event_stream_service:service_manager find;
allow untrusted_app_all aohp_ad_service:service_manager find;

allow platform_app aohp_virtual_display_service:service_manager find;
allow platform_app aohp_container_service:service_manager find;
allow platform_app aohp_agent_view_service:service_manager find;
allow platform_app aohp_vault_service:service_manager find;
allow platform_app aohp_taint_tracker_service:service_manager find;
allow platform_app aohp_sensitivity_registry_service:service_manager find;
allow platform_app aohp_security_bridge_service:service_manager find;
allow platform_app aohp_security_cmd_service:service_manager find;
allow platform_app aohp_file_bridge_service:service_manager find;
allow platform_app aohp_event_stream_service:service_manager find;
allow platform_app aohp_ad_service:service_manager find;

allow priv_app aohp_virtual_display_service:service_manager find;
allow priv_app aohp_container_service:service_manager find;
allow priv_app aohp_agent_view_service:service_manager find;
allow priv_app aohp_vault_service:service_manager find;
allow priv_app aohp_taint_tracker_service:service_manager find;
allow priv_app aohp_sensitivity_registry_service:service_manager find;
allow priv_app aohp_security_bridge_service:service_manager find;
allow priv_app aohp_security_cmd_service:service_manager find;
allow priv_app aohp_file_bridge_service:service_manager find;
allow priv_app aohp_event_stream_service:service_manager find;
allow priv_app aohp_ad_service:service_manager find;
